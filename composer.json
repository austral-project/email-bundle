{
    "name": "austral/email-bundle",
    "type": "symfony-bundle",
    "description": "Create template email and view send email log",
    "keywords": [
        "Austral",
        "Email"
    ],
    "license": "MIT",
    "homepage": "https://austral.dev",
    "authors": [
        {
            "name": "Matthieu Beurel",
            "email": "matthieu@austral.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.4 <9.0",
        "austral/contracts": "^4.0",
        "austral/tools-bundle": "^4.0",
        "austral/entity-translate-bundle": "^4.0",
        "austral/entity-bundle": "^4.0",
        "symfony/routing": "^7.4",
        "symfony/proxy-manager-bridge": "^6.4 || ^7.4",
        "symfony/notifier": "^7.4",
        "symfony/mailer": "^7.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Austral\\EmailBundle\\": ""
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
